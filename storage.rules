rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Explicitly allow safe raster image formats and exclude image/svg+xml to prevent Stored XSS
    function isSafeImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    function isSafeDocument() {
      return isSafeImage() || request.resource.contentType == 'application/pdf';
    }

    function isTripMember(tripId) {
      return isAuthenticated() && (
        firestore.exists(/databases/(default)/documents/trips/$(tripId)/members/$(request.auth.uid)) ||
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberUids.hasAny([request.auth.uid]) ||
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.createdBy == request.auth.uid
      );
    }

    function isTripAdmin(tripId) {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        firestore.get(/databases/(default)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role in ['trip_admin', 'super_admin'] ||
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.createdBy == request.auth.uid
      );
    }

    // Avatars - user can upload own
    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && isSafeImage();
    }

    // Trip covers - allow member or creator to upload
    match /trips/{tripId}/covers/{fileName} {
      allow read: if isTripMember(tripId) || isTripAdmin(tripId);
      allow write: if (isTripMember(tripId) || isTripAdmin(tripId))
        && request.resource.size < 5 * 1024 * 1024
        && isSafeImage();
    }

    // Place images
    match /trips/{tripId}/places/{placeId}/{fileName} {
      allow read: if isTripMember(tripId);
      allow write: if isTripMember(tripId)
        && request.resource.size < 5 * 1024 * 1024
        && isSafeImage();
    }

    // Expense receipts (both direct trip receipts path used by cards.js and nested expense path)
    match /trips/{tripId}/receipts/{fileId} {
      allow read: if isTripMember(tripId);
      allow write: if isTripMember(tripId)
        && request.resource.size < 5 * 1024 * 1024
        && isSafeDocument();
      allow delete: if isTripAdmin(tripId);
    }

    match /trips/{tripId}/expenses/{expenseId}/receipts/{fileId} {
      allow read: if isTripMember(tripId);
      allow write: if isTripMember(tripId)
        && request.resource.size < 5 * 1024 * 1024
        && isSafeDocument();
      allow delete: if isTripAdmin(tripId);
    }

    // Settlement proofs
    match /trips/{tripId}/settlements/{settlementId}/proofs/{fileId} {
      allow read: if isTripMember(tripId);
      allow write: if isTripMember(tripId)
        && request.resource.size < 5 * 1024 * 1024
        && isSafeDocument();
      allow delete: if isTripAdmin(tripId);
    }

    // Deny all else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
