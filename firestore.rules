rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    /**
     * A member status that must lose access. Two spellings exist in the data:
     * `inactive` (written by the membership sweep and by the current สมาชิก →
     * แก้ไข status select) and `disabled` (what older builds of that select
     * wrote). They mean the same thing, so both are revoked — an admin who
     * suspended somebody must not leave them inside the trip through the legacy
     * `memberUids` branch below.
     */
    function revokedMemberStatus(data) {
      return data.get('status', 'active') in ['inactive', 'disabled'];
    }

    function isTripMember(tripId) {
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      let memberPath = /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid);
      return isAuthenticated() && (
        isSuperAdmin()
        || (exists(tripPath) && get(tripPath).data.createdBy == request.auth.uid)
        || (exists(memberPath) && !revokedMemberStatus(get(memberPath).data))
        // Keep the legacy memberUids fallback only when no member document exists.
        // A revoked member document must revoke access even if an old array entry remains.
        || (!exists(memberPath) && exists(tripPath)
          && get(tripPath).data.get('memberUids', []).hasAny([request.auth.uid]))
      );
    }

    function getMemberRole(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role;
    }

    function hasMemberDoc(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    // --- v30 permission helpers -------------------------------------------------
    // The member document carries the role (`trip_admin` | `member` | `viewer`) and
    // three switches the admin sets in สมาชิก → แก้ไข:
    //   canEditItinerary, canEditExpense, canManageMembers
    // A *missing* switch keeps the historical behaviour (members may edit); only an
    // explicit `false` — or the read-only `viewer` role — blocks a write. That way
    // member documents written before v30 keep working after the rules are published.

    function memberData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data;
    }

    function memberRole(tripId) {
      return memberData(tripId).get('role', 'member');
    }

    function memberPermissions(tripId) {
      return memberData(tripId).get('permissions', {});
    }

    function permissionOn(tripId, perm) {
      return !(
        memberPermissions(tripId).keys().hasAny([perm])
        && memberPermissions(tripId)[perm] == false
      );
    }

    function isTripAdmin(tripId) {
      return isSuperAdmin()
        || (isAuthenticated() && exists(/databases/$(database)/documents/trips/$(tripId))
            && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid)
        || (isTripMember(tripId) && hasMemberDoc(tripId) && memberRole(tripId) in ['trip_admin', 'super_admin']);
    }

    /** Kept for compatibility: the old `hasPermission(perm)` helper. */
    function hasPermission(tripId, perm) {
      return isTripAdmin(tripId) || (isTripMember(tripId) && hasMemberDoc(tripId) && permissionOn(tripId, perm));
    }

    /** May this account write ANY trip content? (viewer = read-only everywhere) */
    function canWriteContent(tripId) {
      return isTripAdmin(tripId)
        || (isTripMember(tripId) && (!hasMemberDoc(tripId) || memberRole(tripId) != 'viewer'));
    }

    /** May this account edit the itinerary? (plan, days, sticky notes) */
    function canEditItinerary(tripId) {
      return canWriteContent(tripId)
        && (isTripAdmin(tripId) || !hasMemberDoc(tripId) || permissionOn(tripId, 'canEditItinerary'));
    }

    /** May this account edit money? (expenses, cards, groups, transfers) */
    function canEditExpense(tripId) {
      return canWriteContent(tripId)
        && (isTripAdmin(tripId) || !hasMemberDoc(tripId) || permissionOn(tripId, 'canEditExpense'));
    }

    /** A member the admin trusted with สิทธิ์ “จัดการสมาชิก” (co-admin for people). */
    function canManageMembers(tripId) {
      return isTripAdmin(tripId)
        || (isTripMember(tripId) && hasMemberDoc(tripId)
            && memberRole(tripId) != 'viewer'
            && permissionOn(tripId, 'canManageMembers')
            && memberPermissions(tripId).keys().hasAny(['canManageMembers'])
            && memberPermissions(tripId)['canManageMembers'] == true);
    }

    /** Only a real trip admin may touch another admin's member document. */
    function protectsAdminDoc(tripId) {
      return !(resource.data.get('role', 'member') in ['trip_admin', 'super_admin']) || isTripAdmin(tripId);
    }

    /** A co-admin keeps the role and the switches exactly as they are. */
    function sameRoleAndPermissions() {
      return request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
        && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active');
    }

    /** A delegated member manager may update membership lists, not other trip settings. */
    function managerOnlyChangesMemberUids(tripId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        && request.resource.data.get('memberUids', null) is list
        && request.resource.data.memberUids.size() <= 500
        && canManageMembers(tripId);
    }

    /**
     * Self-repair of a drifted `memberUids` entry. The member documents
     * (`trips/{tripId}/members/{uid}`) and the flat `memberUids` array can
     * drift apart (legacy trips, duplicated trips, a failed write); the trip
     * list query reads only the array, so a real member then sees no trip.
     * Somebody who already holds an ACTIVE member document may add back
     * exactly one entry — their own uid — and nothing else: every existing
     * entry is kept, no other field changes, and no access is granted that
     * the member document does not already give (isTripMember reads it).
     */
    function memberMayRestoreOwnListing(tripId) {
      let before = resource.data.get('memberUids', []);
      let after = request.resource.data.get('memberUids', null);
      return isAuthenticated()
        && hasMemberDoc(tripId)
        && !revokedMemberStatus(memberData(tripId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        && after is list
        && after.hasAll(before)
        // Exactly one entry may be added, and it must be the caller's own:
        // either the caller was missing and the list grows by one around
        // their uid, or they were already listed and the list is unchanged.
        && (before.hasAny([request.auth.uid])
          ? after.size() == before.size()
          : (after.size() == before.size() + 1 && after.hasAny([request.auth.uid])));
    }

    /** A trip admin or delegated member manager sets the layout for everyone. */
    function managerMayUpdateDashboard(tripId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dashboardLayout', 'dashboardHidden', 'updatedAt'])
        && canManageMembers(tripId);
    }

    /** Cover framing is shared, and delegated managers may only write valid coordinates. */
    function managerMayUpdateCoverPosition(tripId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coverPosition', 'updatedAt'])
        && request.resource.data.coverPosition is map
        // v45: the crop also stores `zoom` (how close the chosen part is). x/y stay
        // required so an older client's write is still valid; zoom is optional and
        // clamped to the same range the app writes (utils/coverPosition.js).
        && request.resource.data.coverPosition.keys().hasOnly(['x', 'y', 'zoom'])
        && request.resource.data.coverPosition.keys().hasAll(['x', 'y'])
        && request.resource.data.coverPosition.x is number && request.resource.data.coverPosition.x >= 0 && request.resource.data.coverPosition.x <= 100
        && request.resource.data.coverPosition.y is number && request.resource.data.coverPosition.y >= 0 && request.resource.data.coverPosition.y <= 100
        && request.resource.data.coverPosition.get('zoom', 1) is number
        && request.resource.data.coverPosition.get('zoom', 1) >= 1
        && request.resource.data.coverPosition.get('zoom', 1) <= 3
        && canManageMembers(tripId);
    }

    /** Shared map defaults follow the itinerary permission. */
    function memberMayUpdateMapDefault(tripId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['defaultMapLayer', 'updatedAt'])
        && canEditItinerary(tripId);
    }

    /** Shared payment-card choices follow the expense permission. */
    function memberMayUpdateCards(tripId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cards', 'updatedAt'])
        && canEditExpense(tripId);
    }

    /** Co-admins may add ordinary members/viewers, but cannot grant admin rights. */
    function mayCreateMember(tripId) {
      return canManageMembers(tripId) && (
        isTripAdmin(tripId)
        || (request.resource.data.get('role', 'member') in ['member', 'viewer']
          && request.resource.data.get('permissions', {}).get('canManageMembers', false) != true)
      );
    }

    function tripNoLongerListsMember(tripId, memberId, memberUid) {
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      return !existsAfter(tripPath)
        || (existsAfter(tripPath)
          && !getAfter(tripPath).data.get('memberUids', []).hasAny([memberId, memberUid]));
    }

    /** Legitimate self-service edits of a member document (profile only). */
    function memberSelfUpdateOnlyProfile(tripId, memberId) {
      return isTripMember(tripId)
        && request.auth.uid == memberId
        && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
        && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('uid', memberId) == resource.data.get('uid', memberId)
        && request.resource.data.get('username', '') == resource.data.get('username', '');
    }

    function validProfileFields(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'updatedAt', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && (request.resource.data.email == null
          || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('https://.*')))
        && request.resource.data.updatedAt == request.time;
    }

    function validPublicProfile(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email == request.auth.token.get('email', null)
        && (request.resource.data.email == null
          || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('https://.*')))
        && request.resource.data.updatedAt == request.time;
    }

    function invitePreviewMatchesTrip(tripId, inviteCode) {
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      let tripAfter = getAfter(tripPath);
      return existsAfter(tripPath)
        && request.resource.data.keys().hasOnly(['tripId', 'name', 'startDate', 'endDate'])
        && request.resource.data.keys().hasAll(['tripId', 'name', 'startDate', 'endDate'])
        && request.resource.data.tripId == tripId
        && request.resource.data.name is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && tripAfter.data.inviteCode == inviteCode
        && tripAfter.data.inviteEnabled == true
        && request.resource.data.name == tripAfter.data.name
        && request.resource.data.startDate == tripAfter.data.startDate
        && request.resource.data.endDate == tripAfter.data.endDate;
    }

    function mayWriteInvitePreview(tripId) {
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      return isAuthenticated() && (
        canManageMembers(tripId)
        || (existsAfter(tripPath) && getAfter(tripPath).data.createdBy == request.auth.uid)
      );
    }

    function currentInvitePreviewIsEnabled(inviteCode) {
      let tripId = resource.data.tripId;
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      let trip = get(tripPath);
      return isAuthenticated()
        && tripId is string
        && exists(tripPath)
        && trip.data.inviteCode == inviteCode
        && trip.data.inviteEnabled == true
        && resource.data.keys().hasOnly(['tripId', 'name', 'startDate', 'endDate'])
        && resource.data.name == trip.data.name
        && resource.data.startDate == trip.data.startDate
        && resource.data.endDate == trip.data.endDate;
    }

    function memberHasNoClientCredentialFields(data) {
      return !data.keys().hasAny(['pinHash', 'pinSalt', 'pinIterations', 'pinAlgo']);
    }

    function userHasNoServerOnlyFields(data) {
      return !data.keys().hasAny([
        'pinHash', 'pinSalt', 'pinIterations', 'pinAlgo',
        'lastStepUp', 'lastStepUpAction', 'stepUpExpiry'
      ]);
    }

    // Visit statistics (หน้า สมาชิก) — “เก็บระยะเวลา และวันเวลาที่เข้าล่าสุด”.
    // ONE document per account (`visitStats/{uid}`), never one per visit: it
    // carries only counters and timestamps, so the free Spark quota sees a
    // handful of writes per session (1 on entry + 1 per visible minute).
    //   { uid, lastSeenAt, sessions, totalMs, tripIds[],
    //     trips: { [tripId]: { sessions, ms, lastSeenAt } } }
    // Numbers only — no names, e-mails or content — therefore any signed-in
    // member may read them to fill the Members page. Only the owner may write;
    // the totals may only grow, so a document cannot be rewound by a client.
    match /visitStats/{uid} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (request.resource.data.totalMs is int || request.resource.data.totalMs is float)
        && (request.resource.data.sessions is int || request.resource.data.sessions is float);
      allow update: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && (request.resource.data.totalMs is int || request.resource.data.totalMs is float)
        && request.resource.data.totalMs >= resource.data.totalMs;
      allow delete: if isSuperAdmin();

      // Per-trip slice of the same statistics: { tripId, sessions, ms, lastSeenAt }.
      // A separate document (not a nested map) because Firestore only resolves
      // dotted field paths in update(), and a merge on a map replaces it whole.
      match /trips/{tripId} {
        allow get, list: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == uid
          && request.resource.data.tripId == tripId
          && (request.resource.data.ms is int || request.resource.data.ms is float)
          && (request.resource.data.sessions is int || request.resource.data.sessions is float);
        allow delete: if isSuperAdmin();
      }
    }

    // Users collection - only self or super admin. Self-writes are a fixed profile
    // schema; authentication/step-up fields are server-managed by Admin SDK.
    match /users/{uid} {
      allow read: if isAuthenticated()
        && (request.auth.uid == uid || isSuperAdmin())
        && userHasNoServerOnlyFields(resource.data);
      allow create: if isAuthenticated() && request.auth.uid == uid
        && validProfileFields(uid)
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'member');
      allow update: if userHasNoServerOnlyFields(request.resource.data)
        && (isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid
          && validProfileFields(uid)
          && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])));
      allow delete: if isSuperAdmin();

      // Mirror of the join requests this member sent (so they can see the status).
      match /joinRequests/{tripId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }

      // Web Push devices + what this account wants pushed (v30). Only the owner
      // may read or write them; the Cloud Functions use the Admin SDK.
      match /pushTokens/{tokenId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }

      match /pushPrefs/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Public directory data is owner-readable only. Email search is a callable
    // that checks canManageMembers(tripId) and returns one allowlisted profile.
    match /publicProfiles/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isAuthenticated() && request.auth.uid == uid && validPublicProfile(uid);
      allow update: if isAuthenticated() && request.auth.uid == uid
        && validPublicProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Legacy account PINs and step-up metadata are kept outside readable profiles.
    // Callable Functions use the Admin SDK; no browser can read or write this path.
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // Minimal invite preview: a known code returns only the trip name and dates.
    // These documents are never enumerable and must mirror an enabled trip.
    match /publicTripInvites/{inviteCode} {
      allow get: if currentInvitePreviewIsEnabled(inviteCode);
      allow list: if false;
      allow create: if mayWriteInvitePreview(request.resource.data.tripId)
        && !exists(/databases/$(database)/documents/publicTripInvites/$(inviteCode))
        && invitePreviewMatchesTrip(request.resource.data.tripId, inviteCode);
      allow update: if mayWriteInvitePreview(request.resource.data.tripId)
        && resource.data.tripId == request.resource.data.tripId
        && invitePreviewMatchesTrip(request.resource.data.tripId, inviteCode);
      allow delete: if isAuthenticated() && (
        isSuperAdmin()
        || canManageMembers(resource.data.tripId)
        || (exists(/databases/$(database)/documents/trips/$(resource.data.tripId))
          && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.createdBy == request.auth.uid)
      );
    }

    // Server-only authentication records; callable Functions use the Admin SDK.
    match /loginAccounts/{username} {
      allow read, write: if false;
    }

    match /memberSecrets/{secretId} {
      allow read, write: if false;
    }

    match /publicMemberLogins/{username} {
      allow read, write: if false;
    }

    // Trip discovery for signed-in members (collection-group reads only).
    // The trip list reads `trips.memberUids`, which can drift from the member
    // documents; a member may therefore look up *their own* member documents
    // across trips to find the trips they already belong to. This grants no
    // access to anyone else's document (the nested trips/{tripId}/members
    // rules below still govern reads inside a known trip) and an inactive
    // document is filtered out by the client and grants no trip access.
    match /{path=**}/members/{memberId} {
      allow get, list: if isAuthenticated()
        && memberHasNoClientCredentialFields(resource.data)
        && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('authUid', '') == request.auth.uid
          || memberId == request.auth.uid);
    }

    // Trips - isolated to trip members, creator, or super admin
    match /trips/{tripId} {
      allow get: if isAuthenticated() && isTripMember(tripId);
      // Lists are scoped to trips the caller already belongs to. Invite-code
      // previews are resolved through publicTripInvites/{code}, never by listing trips.
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberUids != null
          && resource.data.memberUids.hasAny([request.auth.uid])
          && (!exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
            || !revokedMemberStatus(get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data)))
      );
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;
      // Ownership is immutable through client writes, including for current admins.
      allow update: if isAuthenticated()
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && (
          isTripAdmin(tripId) ||
          // Membership removals must be paired with the matching membership batch.
          managerOnlyChangesMemberUids(tripId) ||
          // A real member whose memberUids entry drifted away may restore
          // their own listing (and nothing else) — see the helper above.
          memberMayRestoreOwnListing(tripId) ||
          // Non-admin writes are limited to fields covered by their specific capability.
          managerMayUpdateDashboard(tripId) ||
          managerMayUpdateCoverPosition(tripId) ||
          memberMayUpdateMapDefault(tripId) ||
          memberMayUpdateCards(tripId)
        );
      // Creator, super admin or a trip admin may delete the trip
      allow delete: if isSuperAdmin()
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated() && isTripAdmin(tripId));

      // Join requests: anybody signed in may ask (they are not a member yet),
      // only trip admins may read the queue or approve/reject.
      match /joinRequests/{uid} {
        allow get: if isAuthenticated() && (request.auth.uid == uid || canManageMembers(tripId));
        allow list: if isAuthenticated() && canManageMembers(tripId);
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == uid || canManageMembers(tripId));
      }

      // Members - isolated to trip members; role escalation prevented (v30: a
      // member may edit their own profile, but NEVER their role, permissions or
      // status — those stay admin-only).
      match /members/{memberId} {
        allow read: if isTripMember(tripId) && memberHasNoClientCredentialFields(resource.data);
        allow create: if memberHasNoClientCredentialFields(request.resource.data)
          && mayCreateMember(tripId);
        // A trip admin may change anything on a member (except another admin's
        // doc); a *co-admin* (`canManageMembers`) may edit profiles but not the
        // role or the three switches — granting rights stays a trip-admin action.
        allow update: if memberHasNoClientCredentialFields(request.resource.data)
          && (((canManageMembers(tripId) && protectsAdminDoc(tripId)
                && (isTripAdmin(tripId) || sameRoleAndPermissions()))
              && (!revokedMemberStatus(request.resource.data)
                || tripNoLongerListsMember(tripId, memberId, resource.data.get('uid', memberId))))
            || memberSelfUpdateOnlyProfile(tripId, memberId));
        allow delete: if canManageMembers(tripId) && protectsAdminDoc(tripId)
          && (isTripAdmin(tripId)
            || tripNoLongerListsMember(tripId, memberId, resource.data.get('uid', memberId)));
      }

      // Days
      match /days/{dayId} {
        allow read: if isTripMember(tripId);
        allow write: if canEditItinerary(tripId);
      }

      // Itinerary Items - the plan editor follows สิทธิ์ “แก้ไขแผนการเดินทาง”
      match /itineraryItems/{itemId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canEditItinerary(tripId);
      }

      // Expenses - the money editor follows สิทธิ์ “แก้ไขค่าใช้จ่าย”
      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canEditExpense(tripId);

        match /lineItems/{lineItemId} {
          allow read: if isTripMember(tripId);
          allow write: if canEditExpense(tripId);
        }
      }

      // Settlements
      match /settlements/{settlementId} {
        allow read: if isTripMember(tripId);
        // “จ่ายแล้ว” transfers are versioned by the reserved `_transferGuard`
        // document. It only ever moves forward one version at a time, and a
        // transfer may only be written in the same atomic write that bumps it —
        // so a client cannot record a payment without passing the guard.
        function guardFieldsOk() {
          return request.resource.data.keys().hasOnly(['version', 'transferId', 'operation'])
            && request.resource.data.transferId is string
            && request.resource.data.operation in ['create', 'delete'];
        }
        allow create: if settlementId != '_transferGuard'
            ? canEditExpense(tripId)
            : canEditExpense(tripId) && guardFieldsOk() && request.resource.data.version == 1;
        allow update: if settlementId != '_transferGuard'
            ? canEditExpense(tripId)
            : canEditExpense(tripId) && guardFieldsOk()
              && request.resource.data.version is int
              && request.resource.data.version == resource.data.version + 1;
        allow delete: if settlementId != '_transferGuard'
            ? canEditExpense(tripId)
            : isTripAdmin(tripId) && !existsAfter(/databases/$(database)/documents/trips/$(tripId));

        match /payments/{paymentId} {
          allow read: if isTripMember(tripId);
          allow create, update, delete: if canEditExpense(tripId);
        }
      }

      // Expense groups (categories) - feeding the expense form, so money rights
      match /categories/{categoryId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canEditExpense(tripId);
      }

      // Cards - same: only the people who may record money manage the cards
      match /cards/{cardId} {
        allow read: if isTripMember(tripId);
        allow write: if canEditExpense(tripId);
      }

      // Exchange Rates - used by every expense calculation
      match /exchangeRates/{rateId} {
        allow read: if isTripMember(tripId);
        allow write: if canEditExpense(tripId);
      }

      // Settings - trip-wide configuration stays admin-only (the daily-summary
      // hour of the notification feature lives here too)
      match /settings/{settingId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripAdmin(tripId);
      }

      // Activity Logs - every member can read the history and append to it;
      // only admins may remove entries.
      match /activityLogs/{logId} {
        allow read, create: if isTripMember(tripId);
        allow update, delete: if isTripAdmin(tripId);
      }

      // Imports
      match /imports/{importId} {
        allow read, create, update, delete: if isTripAdmin(tripId);
      }

      // Documents
      match /documents/{docId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canWriteContent(tripId);
      }

      // Sticky notes - part of the plan, so the itinerary right applies
      match /notes/{noteId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canEditItinerary(tripId);
      }

      // Prep checklists
      match /checklists/{checklistId} {
        allow read: if isTripMember(tripId);
        allow create, update: if canWriteContent(tripId);
        allow delete: if canWriteContent(tripId) && (
          isTripAdmin(tripId) || !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid
        );
      }

      // Ideas board
      match /ideas/{ideaId} {
        allow read: if isTripMember(tripId);
        allow create, update: if canWriteContent(tripId);
        allow delete: if canWriteContent(tripId) && (
          !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid || isTripAdmin(tripId)
        );
      }

      // Trip sub-groups
      match /memberGroups/{groupId} {
        allow read: if isTripMember(tripId);
        allow create, update: if canWriteContent(tripId);
        allow delete: if canWriteContent(tripId) && (
          !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid || isTripAdmin(tripId)
        );
      }

      // Reservations
      match /reservations/{reservationId} {
        allow read: if isTripMember(tripId);
        allow create, update: if canWriteContent(tripId);
        allow delete: if canWriteContent(tripId) && (
          isTripAdmin(tripId) || !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid
        );
      }

      // Money sent between members to settle up (“จ่ายแล้ว”). A record is written
      // once and can be undone, never edited, so the settlement history stays honest.
      match /transfers/{transferId} {
        allow read: if isTripMember(tripId);
        // Only the same atomic write that bumps the guard may write this record.
        function guardedTransfer(operation) {
          let after = getAfter(/databases/$(database)/documents/trips/$(tripId)/settlements/_transferGuard).data;
          return after.transferId == transferId && after.operation == operation && after.version is int;
        }
        allow create: if canEditExpense(tripId)
          && request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0
          && request.resource.data.fromId != request.resource.data.toId && guardedTransfer('create');
        allow delete: if canEditExpense(tripId) && guardedTransfer('delete');
        allow update: if false;
      }

      // Comments attached to an expense
      match /comments/{commentId} {
        allow read: if isTripMember(tripId);
        allow create: if canWriteContent(tripId);
        allow update, delete: if canWriteContent(tripId) && (
          isTripAdmin(tripId) || !('uid' in resource.data) || resource.data.uid == request.auth.uid
        );
      }

      // Activity log
      match /activity/{entryId} {
        allow read: if isTripMember(tripId);
        allow create: if canWriteContent(tripId);
        allow delete: if isTripAdmin(tripId);
        allow update: if false;
      }

      // Notifications (v30) — the 🔔 bell + Web Push feed of the trip.
      // Any member may add one (that is how “บันทึกค่าใช้จ่าย” pings the others),
      // but nobody can rewrite somebody else's notification: an update may only
      // add/remove the caller's OWN key in `readBy`.
      match /notifications/{notificationId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && (!('body' in request.resource.data) || request.resource.data.body.size() <= 600)
          && (!('pushDelivery' in request.resource.data) || (
            request.resource.data.pushDelivery is map
            && request.resource.data.pushDelivery.keys().hasOnly(['state'])
            && request.resource.data.pushDelivery.state == 'pending'
            && request.resource.data.createdAt == request.time
          ));
        allow update: if isTripMember(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.readBy).addedKeys().hasOnly([request.auth.uid])
          && request.resource.data.readBy.diff(resource.data.readBy).removedKeys().hasOnly([request.auth.uid])
          && request.resource.data.readBy.diff(resource.data.readBy).changedKeys().hasOnly([request.auth.uid]);
        allow delete: if isTripAdmin(tripId);
      }
    }
  }
}
