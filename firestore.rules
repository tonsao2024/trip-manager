rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isTripMember(tripId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/trips/$(tripId)) && get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids.hasAny([request.auth.uid]))
      );
    }

    function getMemberRole(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role;
    }

    function hasMemberDoc(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function isTripAdmin(tripId) {
      return isSuperAdmin() || (isTripMember(tripId) && hasMemberDoc(tripId) && getMemberRole(tripId) in ['trip_admin', 'super_admin']);
    }

    function hasPermission(tripId, perm) {
      return isTripAdmin(tripId) || (isTripMember(tripId) && hasMemberDoc(tripId) && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.permissions[perm] == true);
    }

    // Users collection - only self or super admin
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      // A member signing in with Google/email creates their own profile doc.
      // They may never choose an admin role for themselves.
      allow create: if isAuthenticated() && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'member');
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();

      // Mirror of the join requests this member sent (so they can see the status).
      match /joinRequests/{tripId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Public directory: name / email / photo only, so a trip admin can find the
    // account of somebody who wants to join. No trip data, no permissions here.
    match /publicProfiles/{uid} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // loginAccounts - never allow client read, only via cloud functions
    match /loginAccounts/{username} {
      allow read, write: if false;
    }

    // Public username → trip/member lookup used by the login page so members can
    // sign in with a username + PIN even when Cloud Functions are not deployed.
    // Only a mapping is stored here (no PIN, no secrets).
    match /publicMemberLogins/{username} {
      allow get: if true;                       // login screen resolves the username
      allow list: if request.auth != null;      // no anonymous enumeration
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Trips - permissive for free tier, prevent permission errors
    match /trips/{tripId} {
      // Allow read if member, admin, creator, or memberUids contains uid - also allow list for authenticated to avoid permission denied
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTripMember(tripId) ||
        resource.data.memberUids.hasAny([request.auth.uid]) ||
        resource.data.createdBy == request.auth.uid ||
        // Allow list queries for authenticated users - client will filter
        request.auth != null
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTripAdmin(tripId) ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      // Creator, super admin or a trip admin may delete the trip
      allow delete: if isSuperAdmin()
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated() && isTripAdmin(tripId));

      // Join requests: anybody signed in may ask (they are not a member yet),
      // only trip admins may read the queue or approve/reject.
      match /joinRequests/{uid} {
        allow get: if isAuthenticated() && (request.auth.uid == uid || isTripAdmin(tripId));
        allow list: if isAuthenticated() && isTripAdmin(tripId);
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == uid || isTripAdmin(tripId));
      }

      // Members - permissive to avoid permission errors
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Days
      match /days/{dayId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Itinerary Items - permissive
      match /itineraryItems/{itemId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Expenses - permissive (v4: deletion allowed so items can truly be removed)
      match /expenses/{expenseId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();

        match /lineItems/{lineItemId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // Settlements
      match /settlements/{settlementId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();

        match /payments/{paymentId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
          allow update, delete: if isAuthenticated();
        }
      }

      // Expense groups (v9): every member of the trip sees the trip's own groups,
      // any member may add / rename / re-icon / delete them (built-in groups are
      // protected inside the app, they are never written here).
      match /categories/{categoryId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isTripMember(tripId);
      }

      // Cards
      match /cards/{cardId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Exchange Rates
      match /exchangeRates/{rateId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Settings
      match /settings/{settingId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Activity Logs
      match /activityLogs/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }

      // Imports
      match /imports/{importId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Documents - permissive
      match /documents/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Sticky notes (post-it board on the itinerary page)
      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }
  }
}
