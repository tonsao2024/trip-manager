rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isTripMember(tripId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid ||
          (get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids != null
            && get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids.hasAny([request.auth.uid]))
        ))
      );
    }

    function getMemberRole(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role;
    }

    function hasMemberDoc(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function isTripAdmin(tripId) {
      return isSuperAdmin()
        || (isAuthenticated() && exists(/databases/$(database)/documents/trips/$(tripId))
            && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid)
        || (isTripMember(tripId) && hasMemberDoc(tripId) && getMemberRole(tripId) in ['trip_admin', 'super_admin']);
    }

    function hasPermission(tripId, perm) {
      return isTripAdmin(tripId) || (isTripMember(tripId) && hasMemberDoc(tripId) && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.permissions[perm] == true);
    }

    // Users collection - only self or super admin
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      // A member signing in with Google/email creates their own profile doc.
      // They may never choose an admin role for themselves.
      allow create: if isAuthenticated() && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'member');
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role));
      allow delete: if isSuperAdmin();

      // Mirror of the join requests this member sent (so they can see the status).
      match /joinRequests/{tripId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Public directory: name / email / photo only, so a trip admin can find the
    // account of somebody who wants to join. No trip data, no permissions here.
    match /publicProfiles/{uid} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // loginAccounts - never allow client read, only via cloud functions
    match /loginAccounts/{username} {
      allow read, write: if false;
    }

    // Separated member PIN hashes (never enumerable via list; only writable by trip admin)
    match /memberSecrets/{secretId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAuthenticated()
        && request.resource.data.tripId is string
        && isTripAdmin(request.resource.data.tripId);
      allow delete: if isAuthenticated()
        && resource.data.tripId is string
        && isTripAdmin(resource.data.tripId);
    }

    // Public username → trip/member lookup used by the login page.
    // Enumeration via list is forbidden; only trip admins of the target trip may modify entries.
    match /publicMemberLogins/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAuthenticated()
        && request.resource.data.tripId is string
        && isTripAdmin(request.resource.data.tripId);
      allow delete: if isAuthenticated()
        && resource.data.tripId is string
        && isTripAdmin(resource.data.tripId);
    }

    // Trips - isolated to trip members, creator, or super admin
    match /trips/{tripId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        isTripMember(tripId) ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberUids != null && resource.data.memberUids.hasAny([request.auth.uid]))
      );
      // List is allowed for own/member trips, or single-trip lookup by invite code
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberUids != null && resource.data.memberUids.hasAny([request.auth.uid])) ||
        (resource.data.inviteEnabled == true && request.query.limit <= 1)
      );
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTripAdmin(tripId) ||
        resource.data.createdBy == request.auth.uid ||
        (isTripMember(tripId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.memberUids == resource.data.memberUids)
      );
      // Creator, super admin or a trip admin may delete the trip
      allow delete: if isSuperAdmin()
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated() && isTripAdmin(tripId));

      // Join requests: anybody signed in may ask (they are not a member yet),
      // only trip admins may read the queue or approve/reject.
      match /joinRequests/{uid} {
        allow get: if isAuthenticated() && (request.auth.uid == uid || isTripAdmin(tripId));
        allow list: if isAuthenticated() && isTripAdmin(tripId);
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == uid || isTripAdmin(tripId));
      }

      // Members - isolated to trip members; role escalation prevented
      match /members/{memberId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripAdmin(tripId)
          || (isAuthenticated() && request.auth.uid == memberId
              && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid);
        allow update: if isTripAdmin(tripId)
          || (isTripMember(tripId) && request.auth.uid == memberId
              && request.resource.data.role == resource.data.role);
        allow delete: if isTripAdmin(tripId);
      }

      // Days
      match /days/{dayId} {
        allow read, write: if isTripMember(tripId);
      }

      // Itinerary Items
      match /itineraryItems/{itemId} {
        allow read, create, update, delete: if isTripMember(tripId);
      }

      // Expenses
      match /expenses/{expenseId} {
        allow read, create, update, delete: if isTripMember(tripId);

        match /lineItems/{lineItemId} {
          allow read, write: if isTripMember(tripId);
        }
      }

      // Settlements
      match /settlements/{settlementId} {
        allow read, create, update, delete: if isTripMember(tripId);

        match /payments/{paymentId} {
          allow read, create, update, delete: if isTripMember(tripId);
        }
      }

      // Expense groups (categories)
      match /categories/{categoryId} {
        allow read, create, update, delete: if isTripMember(tripId);
      }

      // Cards
      match /cards/{cardId} {
        allow read, write: if isTripMember(tripId);
      }

      // Exchange Rates
      match /exchangeRates/{rateId} {
        allow read, write: if isTripMember(tripId);
      }

      // Settings
      match /settings/{settingId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripAdmin(tripId);
      }

      // Activity Logs
      match /activityLogs/{logId} {
        allow read, create: if isTripMember(tripId);
        allow update, delete: if false;
      }

      // Imports
      match /imports/{importId} {
        allow read, create, update, delete: if isTripAdmin(tripId);
      }

      // Documents
      match /documents/{docId} {
        allow read, create, update, delete: if isTripMember(tripId);
      }

      // Sticky notes
      match /notes/{noteId} {
        allow read, create, update, delete: if isTripMember(tripId);
      }

      // Prep checklists
      match /checklists/{checklistId} {
        allow read, create, update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId) && (
          isTripAdmin(tripId) || !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid
        );
      }

      // Ideas board
      match /ideas/{ideaId} {
        allow read, create, update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId) && (
          !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid || isTripAdmin(tripId)
        );
      }

      // Trip sub-groups
      match /memberGroups/{groupId} {
        allow read, create, update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId) && (
          !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid || isTripAdmin(tripId)
        );
      }

      // Reservations
      match /reservations/{reservationId} {
        allow read, create, update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId) && (
          isTripAdmin(tripId) || !('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid
        );
      }

      // Comments attached to an expense
      match /comments/{commentId} {
        allow read, create: if isTripMember(tripId);
        allow update, delete: if isTripMember(tripId) && (
          isTripAdmin(tripId) || !('uid' in resource.data) || resource.data.uid == request.auth.uid
        );
      }

      // Activity log
      match /activity/{entryId} {
        allow read, create: if isTripMember(tripId);
        allow delete: if isTripAdmin(tripId);
        allow update: if false;
      }
    }
  }
}
