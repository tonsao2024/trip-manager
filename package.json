{
  "name": "trip-manager",
  "version": "46.0.0",
  "private": true,
  "description": "Trip Manager by TonSkywalker — static trip planner + group expense splitting (GitHub Pages + Firebase). No runtime build step; the site is served as-is.",
  "type": "module",
  "scripts": {
    "build:assets": "node tools/build-assets.mjs",
    "test": "node tests/node-runner.mjs",
    "test:rules": "node --test tests/rules/firestore.test.js",
    "test:membership": "node --test tests/firestore-indexes.test.mjs tests/membership-repair.test.mjs",
    "test:smoke": "node tests/smoke/run.mjs",
    "test:browser:build": "node tests/browser/mobile-build.mjs",
    "test:browser:mobile": "node tests/browser/mobile-check.mjs",
    "test:browser:desktop": "node tests/browser/desktop-check.mjs",
    "test:browser:dashboard": "node tests/browser/dashboard-responsive-check.mjs",
    "test:browser:design": "node tests/browser/design-check.mjs",
    "test:browser:toast-theme": "node tests/browser/toast-theme-check.mjs",
    "test:browser:expense-selection": "node tests/browser/expense-selection-check.mjs",
    "test:browser:floating-actions": "node tests/browser/floating-actions-check.mjs",
    "test:browser:mobile-expenses-navigation": "node tests/browser/mobile-expenses-navigation-check.mjs",
    "test:browser:export": "node tests/browser/export-check.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@fontsource/noto-sans-thai": "^5.2.5",
    "@sparticuz/chromium": "^133.0.0",
    "dayjs": "1.11.13",
    "firebase": "10.12.2",
    "html2canvas": "1.4.1",
    "jsdom": "^30.1.3",
    "jspdf": "2.5.2",
    "lucide": "0.460.0",
    "puppeteer-core": "^24.10.0",
    "tailwindcss": "3.4.17",
    "xlsx": "0.18.5"
  }
}
